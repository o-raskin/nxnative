    }
    if(acao.armed&&(S.chmask.mask&15)&&R.rt.color[0]&&R.rt.color[0]->serial==acao.color.serial) {
        acao.wrote=1;
        uint64_t cube=tex_slot_h(S.tex[1],S.img[1],12); NvProg *fp=S.prog?prog_get(S.prog):nil;
        if(S.ubo[1][2].size>=80&&cube&&fp&&ac_reads_fog_cube(fp->sh[1])) {   // vote: the fog block most scene draws bind with a plausible content wins (a few draws bind zeros)
            float t[20];ubo_read(1,2,0,80,t);
            if(ac_fog_block(t)) {
                int i=0,low=0;for(;i<4&&acao.fogs[i].count&&memcmp(acao.fogs[i].block,t,80);i++)if(acao.fogs[i].count<acao.fogs[low].count)low=i;
                if(i==4)i=low;
                if(!acao.fogs[i].count||memcmp(acao.fogs[i].block,t,80)){memcpy(acao.fogs[i].block,t,80);acao.fogs[i].count=0;acao.fogs[i].cube=cube;}
                if(++acao.fogs[i].count>acao.fog_count){acao.fog_count=acao.fogs[i].count;memcpy(acao.fog,t,80);acao.fog_cube=acao.fogs[i].cube;}
            }
        }
    }
