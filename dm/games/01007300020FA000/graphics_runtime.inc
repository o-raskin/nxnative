static int ac_scene_depth(const tex_t *z) { return z&&z->d.width>=640&&(z->d.format==NVN_FORMAT_DEPTH24_STENCIL8||z->d.format==NVN_FORMAT_DEPTH32F_STENCIL8||z->d.format==NVN_FORMAT_DEPTH32F); }
static void nvn_profile_graphics_pass(const p_set_rt *r) {
    acao.level=ac_ao_level();if(!acao.level||ac_ab_off("ao"))return;ac_ao_init();ac_ao_frame();
    // The pass that loads two RGBA8 targets of the scene's size just before the lighting: the first is the motion buffer (0.5, 0.5 = none), the second the sun shadow mask (white = lit)
    if(r->n>=2&&r->color[0]&&r->color[1]&&r->color[0]->d.format==NVN_FORMAT_RGBA8&&r->color[1]->d.format==NVN_FORMAT_RGBA8&&r->color[0]->d.width>=640&&r->color[0]->d.width==r->color[1]->d.width&&r->color[0]->d.height==r->color[1]->d.height) {
        int fresh=!acao.have_mv||acao.mask.serial!=r->color[1]->serial; acao.mv=*r->color[0];acao.mask=*r->color[1];acao.have_mv=1;
        if(fresh) MLOG("ASTRAL CHAIN: motion buffer (target %u) and sun shadow mask (target %u) found, %ux%u",(unsigned)acao.mv.serial,(unsigned)acao.mask.serial,(unsigned)acao.mv.d.width,(unsigned)acao.mv.d.height); }
    if(acao.done)return;
    const tex_t *c=r->n>0?r->color[0]:NULL,*z=r->depth;
    for(int i=1;i<r->n;i++)if(r->color[i])c=NULL;
    if(passdump())MLOG("[ac-ao] n=%d c=%u z=%u have=%d linear=%d armed=%d wrote=%d",r->n,c?c->d.format:0,z?z->d.format:0,acao.have,acao.lin,acao.armed,acao.wrote);
    int light=c&&ac_scene_depth(z)&&(c->d.format==NVN_FORMAT_R11G11B10F||c->d.format==NVN_FORMAT_RGBA16F)&&c->d.width==z->d.width&&c->d.height==z->d.height;
    if(acao.armed) {if(light&&c->serial==acao.color.serial&&z->serial==acao.depth.serial)return;if(acao.wrote){ac_ao_run();return;}acao.armed=0;}
    if(light) { if(acao.have&&acao.lin&&z->serial==acao.depth.serial){acao.color=*c;acao.armed=1;acao.wrote=0;return;}acao.color=*c;acao.depth=*z;acao.have=1;acao.lin=0;return; }
    if(acao.have&&c&&!z&&c->d.format==NVN_FORMAT_R32F&&c->d.width==acao.depth.d.width&&c->d.height==acao.depth.d.height)acao.lin=1;
}
static void nvn_profile_graphics_draw(void) {
    // The shadow cascades bind orthographic light matrices (rows: x, y, depth coefficients; the last row 0 0 0 1). Their depth row's direction is the light's travel direction, the same for every
    // cascade; the world has Y up, so the direction toward the sun is the one pointing up.
    if(acao.level&&(ac_contact_steps()||ac_sunmask())&&R.rt.depth&&!R.rt.color[0]&&R.rt.depth->d.width>=2048&&R.rt.depth->d.width==R.rt.depth->d.height) {
        for(int slot=0;slot<8;slot++) { const p_bind_buf *b=&S.ubo[0][slot]; if(!b->addr||b->size<64) continue;
            float t[16]; ubo_read(0,slot,0,64,t);
            if(t[12]!=0||t[13]!=0||t[14]!=0||t[15]!=1) continue;
            float l=sqrtf(t[8]*t[8]+t[9]*t[9]+t[10]*t[10]); float l0=sqrtf(t[0]*t[0]+t[1]*t[1]+t[2]*t[2]);
            if(!(l>0)||l>0.05f||!(l0>0)||l0>l*1e6f) continue;   // an orthographic depth row is small; a camera view row has length 1
            float d[3]={t[8]/l,t[9]/l,t[10]/l}; if(d[1]>0) {d[0]=-d[0];d[1]=-d[1];d[2]=-d[2];}   // travel direction, downward
            { static int ln; if(getenv("DM_AC_SHADOWADDR")&&ln<12){ln++;MLOG("[shadow-matrix] slot %d addr %#llx size %llu rows: %g %g %g %g | %g %g %g %g | %g %g %g %g",slot,(unsigned long long)b->addr,(unsigned long long)b->size,t[0],t[1],t[2],t[3],t[4],t[5],t[6],t[7],t[8],t[9],t[10],t[11]);} }
            if(!acsun.ok) MLOG("ASTRAL CHAIN sun: toward the light %+.3f %+.3f %+.3f (from the shadow cascade matrices)",-d[0],-d[1],-d[2]);
            acsun.dir[0]=-d[0];acsun.dir[1]=-d[1];acsun.dir[2]=-d[2];acsun.ok=1; break; }
    }
    if(!acao.level||acao.done||!acao.have||!R.rt.depth||R.rt.depth->serial!=acao.depth.serial)return;
    const p_bind_buf *b=&S.ubo[0][0]; // c3 maps to NVN user slot 0 (bank - 3)
    if(b->addr&&b->size==256) {
        int i=0,low=0;for(;i<4&&acao.cams[i].address&&acao.cams[i].address!=b->addr;i++)if(acao.cams[i].count<acao.cams[low].count)low=i;
        if(i==4)i=low;
        if(acao.cams[i].address!=b->addr){acao.cams[i].address=b->addr;acao.cams[i].count=0;ubo_read(0,0,0,256,acao.cams[i].block);}
